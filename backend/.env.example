PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=macallinai

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# OpenAI — get your key at https://platform.openai.com/account/api-keys
# Leave as placeholder to use demo grading (assignments still submit without OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# AI Teacher
AI_TEACHER_ENABLED=true

# CORS
CORS_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
