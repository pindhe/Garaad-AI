{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "dart.flutterHotReloadOnSave": "always",
  "dart.flutterHotRestartOnSave": "never",
  "editor.formatOnSave": true,
  "[dart]": {
    "editor.formatOnSave": true
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true
  }
}
